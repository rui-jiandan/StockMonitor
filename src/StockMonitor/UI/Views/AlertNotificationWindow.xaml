<Window x:Class="StockMonitor.UI.Views.AlertNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预警通知"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="340"
        SizeToContent="Height"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- 滑入动画 -->
        <Storyboard x:Key="SlideInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                             From="60" To="0" Duration="0:0:0.4"/>
        </Storyboard>
        <!-- 滑出动画 -->
        <Storyboard x:Key="SlideOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                             From="0" To="40" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder" RenderTransformOrigin="0.5,0.5" Margin="8">
        <Border.RenderTransform>
            <TranslateTransform Y="60"/>
        </Border.RenderTransform>
        <Border Background="White" CornerRadius="8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Background="#4A90D9" CornerRadius="8,8,0,0" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="White" FontSize="16" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="预警通知" Foreground="White"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                Background="Transparent" Foreground="#CCFFFFFF" BorderThickness="0"
                                FontSize="12" Padding="4,2" Cursor="Hand"
                                Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 内容区域 -->
                <StackPanel Grid.Row="1" Margin="14,12,14,8">
                    <TextBlock x:Name="StockInfoText" FontSize="15" FontWeight="SemiBold"
                               Foreground="#333333" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AlertDetailText" FontSize="13" Foreground="#555555"
                               TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>

                <!-- 底部操作栏 -->
                <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,8,8" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TimeText" FontSize="11"
                                   Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="知道了" Click="CloseButton_Click"
                                Background="#4A90D9" Foreground="White" BorderThickness="0"
                                FontSize="12" Padding="16,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3A7BC8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
