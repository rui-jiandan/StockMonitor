<Window x:Class="StockMonitor.UI.Views.PositionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作" Width="320" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding StockList}" SelectedItem="{Binding SelectedStock}"
                 Height="150">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Name, Mode=OneWay}"/>
                        <Run Text="("/>
                        <Run Text="{Binding Code, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Margin="0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="数量:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InputQuantity}" Margin="4,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="价格:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InputPrice}" Margin="4,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="新代码:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewCode}" Margin="4,2"/>
            </Grid>
        </StackPanel>

        <UniformGrid Grid.Row="2" Rows="2" Columns="3" Margin="0,8,0,0">
            <Button Content="加仓" Command="{Binding AddPositionCommand}" Margin="2"/>
            <Button Content="减仓" Command="{Binding ReducePositionCommand}" Margin="2"/>
            <Button Content="编辑" Command="{Binding EditPositionCommand}" Margin="2"/>
            <Button Content="删除" Command="{Binding DeletePositionCommand}" Margin="2"/>
            <Button Content="新增股票" Command="{Binding AddNewStockCommand}" Margin="2"/>
        </UniformGrid>
    </Grid>
</Window>
