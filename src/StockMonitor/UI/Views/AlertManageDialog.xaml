<Window x:Class="StockMonitor.UI.Views.AlertManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StockMonitor.UI.Converters"
        Title="预警管理" Width="460" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    <Window.Resources>
        <conv:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <conv:HasPositionToBackgroundConverter x:Key="HasPositionToBackgroundConverter"/>
        <!-- 统一按钮样式 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A7BC8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 删除按钮样式 -->
        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 预警规则列表 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <ListBox ItemsSource="{Binding Rules}" BorderThickness="0"
                     Background="Transparent" FontSize="13">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding StockCode}"
                                       Foreground="#333333" FontWeight="Medium" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TypeDisplayName}"
                                       Foreground="#4A90D9" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Margin="0,0,12,0"
                                       VerticalAlignment="Center">
                                <Run Text="阈值: " Foreground="#888888"/><Run Text="{Binding Threshold, Mode=OneWay}" Foreground="#333333"/>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Margin="0,0,8,0"
                                       VerticalAlignment="Center">
                                <Run Text="(" Foreground="#AAAAAA"/>
                                <Run Text="{Binding IsOneTime, Mode=OneWay, Converter={StaticResource BoolToTextConverter}}"
                                     Foreground="#888888"/>
                                <Run Text=")" Foreground="#AAAAAA"/>
                            </TextBlock>

                            <Button Grid.Column="5" Content="删除"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource DeleteButton}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 添加规则表单 -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12"
                BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="股票:" VerticalAlignment="Center"
                           Margin="0,4" Foreground="#555555" FontSize="13"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding StockOptions}"
                          SelectedItem="{Binding SelectedStockOption}" Margin="4,4"
                          FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPosition}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="{Binding HasPosition, Converter={StaticResource HasPositionToBackgroundConverter}}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="预警类型:" VerticalAlignment="Center"
                           Margin="0,4" Foreground="#555555" FontSize="13"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AlertTypeItems}"
                          SelectedItem="{Binding SelectedAlertTypeItem}" Margin="4,4"
                          FontSize="13" DisplayMemberPath="DisplayName"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="阈值:" VerticalAlignment="Center"
                           Margin="0,4" Foreground="#555555" FontSize="13"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ThresholdText}" Margin="4,4"
                         FontSize="13" Padding="4,2"/>

                <CheckBox Grid.Row="3" Grid.Column="1" Content="一次性预警" IsChecked="{Binding IsOneTime}"
                          Margin="4,4" FontSize="13" Foreground="#555555"/>
            </Grid>
        </Border>

        <Button Grid.Row="2" Content="添加规则" Command="{Binding AddRuleCommand}"
                Style="{StaticResource ActionButton}"
                HorizontalAlignment="Left" Margin="0,12,0,0"/>
    </Grid>
</Window>
