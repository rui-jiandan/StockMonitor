<Window x:Class="StockMonitor.UI.Views.ConfigEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StockMonitor.UI.ViewModels"
        Title="编辑配置" Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MinWidth="350" MinHeight="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="显示格式:" Margin="0,0,0,4" FontWeight="Bold"/>
                <TextBox x:Name="ShowFormatBox" Text="{Binding ShowFormat, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="50" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         GotFocus="ShowFormatBox_GotFocus"/>
                <TextBlock Text="可用占位符（点击插入）:" Margin="0,4,0,2" FontSize="10" Foreground="Gray"/>
                <ItemsControl ItemsSource="{Binding ShowFormatPlaceholders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E0E0E0" CornerRadius="3" Margin="2,1" Padding="4,2"
                                    Cursor="Hand" MouseDown="Placeholder_MouseDown">
                                <TextBlock FontSize="10">
                                    <Run Text="{Binding Tag, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Description, Mode=OneWay}" Foreground="Gray"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="今日汇总格式:" Margin="0,8,0,4" FontWeight="Bold"/>
                <TextBox x:Name="TodaySumFormatBox" Text="{Binding ShowTodaySumFormat, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="50" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         GotFocus="TodaySumFormatBox_GotFocus"/>
                <TextBlock Text="可用占位符（点击插入）:" Margin="0,4,0,2" FontSize="10" Foreground="Gray"/>
                <ItemsControl ItemsSource="{Binding TodaySumFormatPlaceholders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E0E0E0" CornerRadius="3" Margin="2,1" Padding="4,2"
                                    Cursor="Hand" MouseDown="Placeholder_MouseDown">
                                <TextBlock FontSize="10">
                                    <Run Text="{Binding Tag, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Description, Mode=OneWay}" Foreground="Gray"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="刷新间隔(ms):" Margin="0,8,0,4" FontWeight="Bold"/>
                <TextBox Text="{Binding RefreshTime}" />

                <TextBlock Text="排序方式:" Margin="0,8,0,4" FontWeight="Bold"/>
                <TextBox Text="{Binding OrderBy}" />

                <TextBlock Text="最大可见股票数:" Margin="0,8,0,4" FontWeight="Bold"/>
                <TextBox Text="{Binding MaxVisibleStocks}" />
                <TextBlock Text="超出此数量的股票通过滚动条查看，默认5" FontSize="10" Foreground="Gray" Margin="0,2,0,0"/>

                <Separator Margin="0,8"/>

                <TextBlock Text="预览效果:" Margin="0,0,0,4" FontWeight="Bold"/>
                <Border Background="#1A1A1A" CornerRadius="4" Padding="8,6">
                    <TextBlock Text="{Binding PreviewText}"
                               Foreground="#BBBBBB" FontSize="11"
                               FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="保存" Width="60" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="取消" Width="60" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
