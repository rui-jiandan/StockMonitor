<Window x:Class="StockMonitor.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StockMonitor.UI.ViewModels"
        xmlns:conv="clr-namespace:StockMonitor.UI.Converters"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="StockMonitor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="260" SizeToContent="Height"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <conv:PnLToBrushConverter x:Key="PnLToBrushConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Border Background="#CC000000" CornerRadius="5" Padding="8"
                PreviewMouseDown="Border_PreviewMouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="SummaryText"
                           Text="{Binding TodaySummary}"
                           Foreground="{Binding SummaryColor, Converter={StaticResource PnLToBrushConverter}}"
                           FontSize="11"
                           Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="0,0,4,0">
                    <ItemsControl x:Name="StockItemsControl" ItemsSource="{Binding Stocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StockDisplayItem}">
                                <StackPanel Margin="0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#BBBBBB" FontSize="11"/>
                                        <TextBlock Text="{Binding PnlText}"
                                                   Foreground="{Binding PriceColor, Converter={StaticResource PnLToBrushConverter}}"
                                                   FontSize="11" Margin="8,0,0,0"
                                                   Visibility="{Binding HasPosition, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PriceText}"
                                                   Foreground="{Binding PriceColor, Converter={StaticResource PnLToBrushConverter}}"
                                                   FontSize="10"/>
                                        <TextBlock Text="{Binding ChangeText}"
                                                   Foreground="{Binding PriceColor, Converter={StaticResource PnLToBrushConverter}}"
                                                   FontSize="10" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding ChangeRateText}"
                                                   Foreground="{Binding PriceColor, Converter={StaticResource PnLToBrushConverter}}"
                                                   FontSize="10" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <tb:TaskbarIcon x:Name="NotifyIcon" IconSource="pack://application:,,,/icon.ico" ToolTipText="StockMonitor"
                        Visibility="Visible"
                        DoubleClickCommand="{Binding ToggleVisibilityCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示" Click="Menu_Show"/>
                    <MenuItem Header="操作" Click="Menu_PositionEdit"/>
                    <MenuItem Header="预警管理" Click="Menu_AlertManage"/>
                    <MenuItem Header="编辑配置" Click="Menu_ConfigEdit"/>
                    <Separator/>
                    <MenuItem Header="刷新" Click="Menu_Refresh"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="Menu_Exit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
